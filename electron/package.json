{
  "name": "splitshot",
  "version": "1.0.7",
  "description": "Competition shooting video analysis, scoring, and export",
  "main": "main.js",
  "scripts": {
    "bundle": "node ../scripts/bundle-python.js",
    "dev": "electron .",
    "start": "node ../scripts/bundle-python.js && electron .",
    "check": "node ../scripts/bundle-python.js check",
    "test:launch-intent": "node --test tests/launch-intent.test.js",
    "test:electron-smoke": "node tests/smoke.test.js",
    "test:electron-iterate": "node tests/iterate.test.js",
    "build:app:mac": "node ../scripts/bundle-python.js && electron-builder --config electron-builder.config.cjs --mac dir --publish=never",
    "build:smoke:mac": "node ../scripts/bundle-python.js && electron-builder --config electron-builder.config.cjs --mac dir --publish=never",
    "build:smoke:win": "node ../scripts/bundle-python.js && electron-builder --config electron-builder.config.cjs --win dir --publish=never",
    "build:smoke:linux": "node ../scripts/bundle-python.js && electron-builder --config electron-builder.config.cjs --linux dir --publish=never",
    "build": "node ../scripts/bundle-python.js && electron-builder --config electron-builder.config.cjs --publish=never",
    "build:mac": "node ../scripts/bundle-python.js && electron-builder --config electron-builder.config.cjs --mac --publish=never",
    "build:mac:local": "uv run python ../scripts/release/build_local_macos.py",
    "build:win": "node ../scripts/bundle-python.js && electron-builder --config electron-builder.config.cjs --win --publish=never",
    "build:linux": "node ../scripts/bundle-python.js && electron-builder --config electron-builder.config.cjs --linux --publish=never"
  },
  "repository": "github:jklock/splitshot",
  "author": "SplitShot",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.52.0"
  }
}
